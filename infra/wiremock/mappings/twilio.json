{
  "mappings": [
    {
      "request": { "method": "POST", "urlPathPattern": "/twilio/2010-04-01/Accounts/.+/Messages.json" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "sid": "SM{{randomValue length=32 type='HEXADECIMAL'}}", "status": "queued" }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "/twilio/.+",
        "bodyPatterns": [{ "contains": "To=%2B15005550001" }]
      },
      "response": { "status": 503, "body": "Servicio no disponible (simulado)" }
    }
  ]
}
