{
  "name": "@notifyhub/client",
  "version": "0.1.0",
  "description": "SDK de TypeScript para la API de NotifyHub: notificaciones multicanal con fallback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joseraulsoriano/notifyhub.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/joseraulsoriano/notifyhub#readme",
  "bugs": {
    "url": "https://github.com/joseraulsoriano/notifyhub/issues"
  },
  "keywords": [
    "notifications",
    "multichannel",
    "fallback",
    "email",
    "sms",
    "push",
    "webhook",
    "cloudflare-workers",
    "sdk",
    "typescript"
  ],
  "author": "José Raúl Soriano Cazabal y Andreea Margarita Maldonado Morales",
  "publishConfig": {
    "access": "public"
  }
}
