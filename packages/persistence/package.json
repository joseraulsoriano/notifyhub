{
  "name": "@notifyhub/persistence",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.json",
    "typecheck": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env dist/seed.js"
  },
  "dependencies": {
    "@notifyhub/application": "workspace:*",
    "@notifyhub/domain": "workspace:*",
    "@prisma/client": "^6.7.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^6.7.0"
  },
  "files": [
    "dist",
    "generated",
    "prisma"
  ]
}
