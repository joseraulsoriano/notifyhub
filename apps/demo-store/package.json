{
  "name": "@notifyhub/demo-store",
  "version": "0.1.0",
  "private": true,
  "description": "Tienda en línea de demostración que notifica a sus clientes a través de NotifyHub.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "node scripts/build-vercel.mjs",
    "deploy:vercel": "node scripts/build-vercel.mjs && vercel deploy --prod --cwd vercel"
  },
  "dependencies": {
    "@notifyhub/client": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typescript": "~5.8.3",
    "vitest": "^3.1.0",
    "wrangler": "^4.149.0"
  }
}
